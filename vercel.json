{
  "version": 2,
  "buildCommand": "cd Frontend && npm install && npm run build",
  "outputDirectory": "Frontend/dist",
  "env": {
    "BACKEND_URL": "https://sub-admin-cxjq.onrender.com",
    "VITE_API_BASE_URL": "https://sub-admin-cxjq.onrender.com"
  },
  "build": {
    "env": {
      "VITE_API_BASE_URL": "https://sub-admin-cxjq.onrender.com"
    }
  },
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/[...path]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
